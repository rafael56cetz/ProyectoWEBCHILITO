# Valores que debe suministrar el operador. No contiene secretos utilizables.
CHILITO_ENV=local
CHILITO_DJANGO_KEY=
CHILITO_SUPPORT_KEY=
CHILITO_DB_HOST=127.0.0.1
CHILITO_DB_PORT=55433
CHILITO_DB_NAME=chilito_integracion_sinteticos
CHILITO_DB_USER=chilito_pkg_runtime
CHILITO_DB_PASSWORD=
CHILITO_ORIGIN=http://127.0.0.1:8780
CHILITO_MAILBOX=/tmp/el-chilito-integracion-correo-pruebas
CHILITO_SMTP_ENABLED=0
CHILITO_SMTP_HOST=
CHILITO_SMTP_PORT=587
CHILITO_SMTP_USER=
CHILITO_SMTP_PASSWORD=
# restricted: destinatarios explícitos; any-valid: registro público confirmado por el propietario
CHILITO_SMTP_RECIPIENT_MODE=restricted
CHILITO_SMTP_ALLOWED_RECIPIENTS=
CHILITO_FROM_EMAIL=El Chilito <no-reply@example.test>
