# Plantilla del .env de El Chilito. Cópiala como .env en la raíz del proyecto y llena cada valor.
# No contiene secretos: nunca subas tu .env al repositorio.
# Para generar una clave aleatoria:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Perfil ──────────────────────────────────────────────────────────────────────────────────
# Obligatoria. local = tu equipo; testing = pruebas automáticas; deployment = servidor público.
CHILITO_ENV=local
# Obligatoria en local (1 = mensajes de depuración). En despliegue debe ser 0.
CHILITO_DEBUG=1

# ── Secretos de la aplicación (cada uno distinto) ───────────────────────────────────────────
# Obligatoria. Clave de Django, mínimo 32 caracteres. Generar con el comando de arriba.
CHILITO_DJANGO_KEY=
# Obligatoria. Firma los recibos de idempotencia, mínimo 32 bytes. Generar con el comando de arriba.
CHILITO_IDEMPOTENCIA_SECRETO=
# Obligatoria. Firma los códigos de vinculación de equipos, mínimo 32 bytes. Generar con el comando de arriba.
CHILITO_VINCULACION_SECRETO=
# Cifra los secretos del segundo factor (TOTP). Opcional en local (se deriva de CHILITO_DJANGO_KEY);
# obligatoria en despliegue. Generar con:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHILITO_MFA_KEY=

# ── Base de datos de la aplicación ──────────────────────────────────────────────────────────
# Obligatorias. La aplicación usa el rol limitado chilito_pkg_runtime (lo crea el Manual de instalación).
CHILITO_DB_NAME=chilito_integracion_sinteticos
CHILITO_DB_USER=chilito_pkg_runtime
# La contraseña que le pusiste al rol chilito_pkg_runtime al instalar la base.
CHILITO_DB_PASSWORD=
CHILITO_DB_HOST=127.0.0.1
CHILITO_DB_PORT=5432
# disable en tu equipo; verify-full en despliegue (obligatorio allí).
CHILITO_DB_SSLMODE=disable

# ── Correo ──────────────────────────────────────────────────────────────────────────────────
# Opcional en local: sin SMTP, los correos (códigos de acceso) se guardan como archivos en esta carpeta.
CHILITO_MAILBOX=/tmp/el-chilito-correo
# Opcional. Ruta a un archivo JSON con los datos SMTP, FUERA del repositorio y con permisos 0600.
# Se crea con:  .venv/bin/python backend/tools/configurar_correo.py
CHILITO_SMTP_CONFIG=
# En despliegue el SMTP es obligatorio y se configura con estas variables en lugar del archivo anterior.
# 1 activa el envío real; 0 lo desactiva.
CHILITO_SMTP_ENABLED=0
CHILITO_SMTP_HOST=
CHILITO_SMTP_PORT=587
CHILITO_SMTP_USER=
# Contraseña de aplicación del proveedor de correo, nunca la contraseña personal.
CHILITO_SMTP_PASSWORD=
# restricted = solo envía a CHILITO_SMTP_ALLOWED_RECIPIENTS; any-valid = a cualquier dirección.
CHILITO_SMTP_RECIPIENT_MODE=restricted
# Direcciones permitidas, separadas por comas (modo restricted).
CHILITO_SMTP_ALLOWED_RECIPIENTS=
# Remitente de los correos, por ejemplo: El Chilito <no-reply@tu-dominio>
CHILITO_FROM_EMAIL=

# ── Operación ───────────────────────────────────────────────────────────────────────────────
# Opcional. Correo del buzón de soporte; la administración abre Gmail con esa cuenta.
CHILITO_CONTACTO_SOPORTE=
# 1 permite crear cuentas nuevas. Por omisión: 1 en local y 0 en despliegue.
CHILITO_REGISTRATION_ENABLED=1

# ── Pruebas automáticas (backend/tools/pruebas_local.py) ────────────────────────────────────
# Obligatorias para correr las pruebas, que crean y borran la base temporal test_chilito_integracion_sinteticos.
# Debe ser el dueño de la base: chilito_pkg_owner.
CHILITO_TEST_DB_USER=chilito_pkg_owner
CHILITO_TEST_DB_PASSWORD=
# Contraseñas de los roles en la base de pruebas. RUNTIME e IOT las usan los flujos y la prueba del simulador
# (si faltan, esas pruebas se omiten). OWNER la usan las pruebas propias de la base.
CHILITO_PRUEBAS_CLAVE_OWNER=
CHILITO_PRUEBAS_CLAVE_RUNTIME=
CHILITO_PRUEBAS_CLAVE_IOT=

# ── Simulador de equipo (backend/tools/simular_equipo.py) ───────────────────────────────────
# Opcional. Solo corre con CHILITO_ENV=local o testing y CHILITO_DEBUG=1.
# Base donde escribe; solo acepta bases de desarrollo o de pruebas.
CHILITO_SIM_DB=chilito_integracion_sinteticos
CHILITO_SIM_HOST=localhost
CHILITO_SIM_PUERTO=5432
# Contraseña del rol chilito_pkg_iot (el mismo rol que usa el servicio IoT real).
CHILITO_SIM_CLAVE_IOT=
# Dirección del servicio de vinculación que usa la acción «vincular».
CHILITO_SIM_URL=http://localhost:8780/api/dispositivos/vincular

# ── Despliegue (solo con CHILITO_ENV=deployment) ────────────────────────────────────────────
# Dirección pública; en despliegue debe empezar con https://. En local es http://localhost:8780.
CHILITO_ORIGIN=http://localhost:8780
# Obligatoria en despliegue. Nombres de host permitidos, separados por comas (sin *).
CHILITO_ALLOWED_HOSTS=
# 1 solo si un proxy propio (por ejemplo, el balanceador de Google Cloud) reemplaza X-Forwarded-Proto.
CHILITO_BEHIND_PROXY=0
# Número de proxies de confianza delante de la aplicación (con CHILITO_BEHIND_PROXY=1).
CHILITO_TRUSTED_PROXY_COUNT=1
