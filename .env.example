# ===================== YouGarden · .env.local.example =====================
# Plantilla SIN secretos reales. Copia a .env (que nunca se sube) y rellena.

# --- Perfil ---
CHILITO_ENV=local
CHILITO_DEBUG=1

# --- Claves (genera cada una con el comando indicado; las tres deben ser distintas) ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
CHILITO_DJANGO_KEY=CAMBIAR_clave_django_minimo_32_caracteres_xxxxxxxxxx
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CHILITO_IDEMPOTENCIA_SECRETO=CAMBIAR_secreto_idempotencia_minimo_32_bytes_xxxx
CHILITO_VINCULACION_SECRETO=CAMBIAR_secreto_vinculacion_minimo_32_bytes_xxxxx
# Opcional en local (si falta se deriva de CHILITO_DJANGO_KEY). Si la pones, que sea Fernet:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CHILITO_MFA_KEY=

# --- Base de datos local (solo se permite este nombre en el perfil local) ---
CHILITO_DB_NAME=chilito_integracion_sinteticos
CHILITO_DB_USER=chilito_pkg_runtime
CHILITO_DB_PASSWORD=CAMBIAR_clave_runtime_local
CHILITO_DB_HOST=127.0.0.1
CHILITO_DB_PORT=5432
CHILITO_DB_SSLMODE=disable

# --- Origen (servir_local.py lo fija igual; usa localhost, no 127.0.0.1) ---
CHILITO_ORIGIN=http://localhost:8780

# --- Registro y legales ---
CHILITO_REGISTRATION_ENABLED=1
# 1 solo para crear la primera cuenta en una base vacía; luego bórrala o pon 0
CHILITO_BYPASS_LEGAL_CHECK=0
CHILITO_VERIFICAR_FILTRADAS=0
CHILITO_CONTACTO_SOPORTE=

# --- Correo: por defecto los códigos van a un archivo local (abre el .eml para ver el código) ---
CHILITO_SMTP_ENABLED=0
CHILITO_MAILBOX=/tmp/el-chilito-integracion-correo-pruebas
# Para correo real usa un JSON 0600 FUERA del repo (python backend/tools/configurar_correo.py --archivo ... --remitente ...)
# CHILITO_SMTP_CONFIG=/home/TU_USUARIO/.config/yougarden/smtp.json
# ...o, si prefieres, las variables directas (nunca subas el .env con ellas rellenas):
# CHILITO_SMTP_ENABLED=1
# CHILITO_SMTP_HOST=smtp.proveedor.com
# CHILITO_SMTP_PORT=587
# CHILITO_SMTP_USER=CAMBIAR_usuario_smtp
# CHILITO_SMTP_PASSWORD=CAMBIAR_contrasena_de_aplicacion
# CHILITO_FROM_EMAIL=YouGarden <no-reply@ejemplo.test>
# CHILITO_SMTP_RECIPIENT_MODE=restricted
# CHILITO_SMTP_ALLOWED_RECIPIENTS=persona1@ejemplo.test

# --- Solo en la nube (en local no se usan; ver .env.cloud.example) ---
# CHILITO_ALLOWED_HOSTS, CHILITO_BEHIND_PROXY, CHILITO_TRUSTED_PROXY_COUNT

# --- Solo para backend/tools/pruebas_local.py (suite y flujos en base temporal) ---
CHILITO_TEST_DB_USER=chilito_pkg_owner
CHILITO_TEST_DB_PASSWORD=CAMBIAR_clave_owner_local
# CHILITO_PRUEBAS_CLAVE_RUNTIME=CAMBIAR_clave_runtime_local
# CHILITO_PRUEBAS_CLAVE_IOT=CAMBIAR_clave_iot_local

# --- Solo para backend/tools/simular_equipo.py (simulador del ESP32; base sintética) ---
# CHILITO_SIM_DB=chilito_integracion_sinteticos
# CHILITO_SIM_HOST=localhost
# CHILITO_SIM_PUERTO=5432
# CHILITO_SIM_CLAVE_IOT=CAMBIAR_clave_iot_local
# CHILITO_SIM_URL=http://localhost:8780/api/dispositivos/vincular
